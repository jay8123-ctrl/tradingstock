# Copy to .env (NEVER commit .env to git, chat, or logs)
# Separate keys for PAPER and LIVE. Keep withdrawals DISABLED.

TRADING_MODE=PAPER

# Alpaca (US Equities Paper Trading - free)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Moomoo OpenD (Malaysia / US - optional local gateway)
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# Telegram Bot Notifications (via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
